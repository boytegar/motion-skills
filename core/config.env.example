# Motion explainer config — copy to the path env.sh reads:
#
#   mkdir -p ~/.config/motion-explainer
#   cp <repo>/core/config.env.example ~/.config/motion-explainer/config.env
#   chmod 600 ~/.config/motion-explainer/config.env        # it holds an API key
#
# Or point MOTION_CONFIG at this file instead. `install.sh` writes MOTION_HOME and MOTION_LIB
# here on its own; the keys below are all optional.
#
# Format: one `KEY=value` per line. No quotes, no `$VAR`, no inline comments — everything after
# `=` is the value, verbatim. Lines starting with `#` and blank lines are ignored.
# A variable already exported in your shell wins over the file.


# --- paths -------------------------------------------------------------------
# Filled by install.sh. Leave commented to let env.sh work it out from its own location.
# MOTION_HOME=/path/to/motion
# MOTION_LIB=/path/to/motion/core
#
# Python with numpy, Pillow and soundfile (sheet.py, contact sheets). Default: python3
# MOTION_PY=/path/to/python
#
# Default style folder name under style/. Default: unset (the skill asks once, then stores it)
# MOTION_STYLE=papercut


# --- voice engine ------------------------------------------------------------
# Without TTS_PROVIDER and TTS_URL, narrate.sh uses local Qwen3-TTS (core/voice/narrate.py).
# With either set, it calls core/voice/tts_provider.py and a hosted API instead.
#
#   TTS_PROVIDER   openai | elevenlabs | custom
#                  empty + TTS_URL set -> custom
#   TTS_URL        endpoint to POST to; also selects the provider on its own
#                    with openai      replaces https://api.openai.com/v1/audio/speech
#                    with elevenlabs  replaces https://api.elevenlabs.io/v1/text-to-speech/<voice>
#                    with custom      required; {voice} and {model} are substituted
#   TTS_API_KEY    key for the provider (TTS_<PROVIDER>_KEY also works)
#   TTS_MODEL      model id           (openai: gpt-4o-mini-tts, elevenlabs: eleven_multilingual_v2)
#   TTS_VOICE      voice id           (openai: alloy, elevenlabs: 21m00Tcm4TlvDq8ikWAM)
#   TTS_SPEED      pace, 0.25-4.0     (default 1.0)
#   TTS_LANG       language tag sent where the API takes one (default: `language` in voice.json)
#   TTS_FORMAT     reply encoding, default mp3
#   TTS_TIMEOUT    request timeout in seconds, default 90
#
# custom only:
#   TTS_AUTH       none (default) | bearer | <header name>
#   TTS_PAYLOAD    JSON body; {text} {voice} {model} {lang} {speed} are substituted

# -- A. OpenAI (or any OpenAI-compatible host) --------------------------------
# TTS_PROVIDER=openai
# TTS_API_KEY=sk-...
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_SPEED=1.0
# TTS_LANG=en

# Same, pointed at a gateway / proxy / self-hosted server:
# TTS_PROVIDER=openai
# TTS_URL=https://gateway.internal/v1/audio/speech
# TTS_API_KEY=sk-gw

# -- B. ElevenLabs ------------------------------------------------------------
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=...
# TTS_MODEL=eleven_multilingual_v2
# TTS_VOICE=21m00Tcm4TlvDq8ikWAM

# -- C. A custom JSON endpoint (TTS_URL alone is enough) ----------------------
# TTS_URL=http://localhost:8000/v1/audio/speech
# TTS_AUTH=bearer
# TTS_API_KEY=local
# TTS_PAYLOAD={"text": "{text}", "voice": "{voice}", "model": "{model}", "speed": {speed}}
# TTS_FORMAT=mp3

# -- D. Local Qwen3-TTS (nothing to set here) --------------------------------
# QWEN_TTS_PY=/path/to/venv/bin/python     python with qwen-tts + torch (+ librosa for the pitch pass)
# QWEN_TTS_HOME=/path/to/qwen_tts_src      only for a source checkout instead of pip
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# ASR_PY=/path/to/venv/bin/python          python with mlx-whisper or faster-whisper
# FASTER_WHISPER_MODEL=large-v3-turbo
# HF_HUB_OFFLINE=1                         once the model is cached, skip network checks


# --- caption sync ------------------------------------------------------------
# Words per second the pace report (core/tools/pace.py) judges each line against.
# Lines more than 12% off it are flagged at the end of finalize.sh; adjust TTS_SPEED
# (or `tempo` in voice.json for a local voice) and re-run. Default: 3.3
# PACE_TARGET=3.3
