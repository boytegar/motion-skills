// ===== shared kyfram helpers: no styling lives here =====
//
// Every scene gets this prelude prepended by core/tools/render_kyfram.py, after the
// style prelude and before the generated header. Write shapes; never re-declare these.

// A fallback cap on how wide one glyph can draw, as a multiple of its font size.
// Measured on Archivo Black: 0.30 ("i") to 0.93 ("M"); 0.70 plus padding clears both.
let GLYPH = 0.70

let textW = fn(txt, size) { return len(txt) * size * GLYPH }

let pad = fn(w, extra) {
  let out = w + extra
  if out < extra * 2 { out = extra * 2 }
  return out
}

let clamp = fn(v, lo, hi) {
  let out = v
  if out < lo { out = lo }
  if out > hi { out = hi }
  return out
}

// A keyframe table that fades and pops in over 0.09 s, starting at t0.
// Repeats content and color on both keys: kyfram renders an omitted color as white,
// and text content never interpolates anyway.
let popText = fn(txt, cx, cy, size, t0, ink) {
  let kf = table{}
  kf[toStr(t0)] = table{content: txt, x: cx, y: cy, size: size, color: ink, alpha: 0, scale: 0.86, rotate: -3}
  kf[toStr(t0 + 0.09)] = table{content: txt, x: cx, y: cy, size: size, color: ink, alpha: 1, scale: 1, rotate: 0, ease: "cubicOut"}
  return kf
}

// A rounded plate behind one word, popping with it.
let popPlate = fn(cx, cy, w, h, t0, fill, radius) {
  let kf = table{}
  kf[toStr(t0)] = table{x: cx - w / 2.0, y: cy - h / 2.0, w: w, h: h, radius: radius, color: fill, alpha: 0}
  kf[toStr(t0 + 0.09)] = table{x: cx - w / 2.0, y: cy - h / 2.0, w: w, h: h, radius: radius, color: fill, alpha: 1}
  return kf
}

// One caption tag: plate + word, both popping on the cue frame.
let drawTag = fn(name, word, cx, cy, t0, size, plate, ink, radius) {
  let w = pad(textW(word, size), 34)
  let h = size * 1.55
  shape("plate_${name}", "roundRect", popPlate(cx, cy, w, h, t0, plate, radius))
  text("word_${name}", popText(word, cx, cy, size, t0, ink))
}

// A centred row of tags from a cue list [{w, f, e}], rendered as paged groups of
// PAGE_SIZE words so the full font size is preserved on a 1080-wide canvas.
// Each page appears only while its words are active (alpha 0→1 on the first word's
// onset, 1→0 immediately after the last word's end), so the row never tries to fit
// more words than the page holds and the scale factor stays at 1.0.
// PAGE_SIZE = 3 (matches style guide: "pages of 1-3").
let drawCaptionRow = fn(list, cy, size, plate, ink, maxW, radius) {
  let gap = 16.0
  let PAGE = 3.0
  // ── build pages: each page is a slice of up to PAGE words ──────────────
  let n = len(list)
  let numPages = mathCeil(n * 1.0 / PAGE)
  for pi in range(0, numPages) {
    let start = pi * 3
    let stop = start + 3
    if stop > n { stop = n }
    // measure this page only
    let ptotal = 0.0
    for j in range(start, stop) {
      ptotal = ptotal + pad(textW(list[j].w, size), 34) + gap
    }
    ptotal = ptotal - gap
    let sc = maxW / ptotal
    if sc > 1.0 { sc = 1.0 }
    // onset = frame of first word in page; end = frame of last word in page
    let onF = list[start].f
    let enF = list[stop - 1].e
    let tOn  = onF * 1.0 / (FPSR * 1.0)
    let tOff = enF * 1.0 / (FPSR * 1.0)
    let x = 540.0 - ptotal * sc / 2.0
    for j in range(start, stop) {
      let c = list[j]
      let tw = pad(textW(c.w, size), 34) * sc
      let cx = x + tw / 2.0
      let t0 = c.f * 1.0 / (FPSR * 1.0)
      // plate and word pop in at onset, entire page fades out at page end
      let ph = size * sc * 1.55
      let kfPlate = table{}
      kfPlate[toStr(t0)]          = table{x: cx - tw / 2.0, y: cy - ph / 2.0, w: tw, h: ph, radius: radius, color: plate, alpha: 0}
      kfPlate[toStr(t0 + 0.09)]   = table{x: cx - tw / 2.0, y: cy - ph / 2.0, w: tw, h: ph, radius: radius, color: plate, alpha: 1}
      kfPlate[toStr(tOff - 0.04)] = table{x: cx - tw / 2.0, y: cy - ph / 2.0, w: tw, h: ph, radius: radius, color: plate, alpha: 1}
      kfPlate[toStr(tOff)]        = table{x: cx - tw / 2.0, y: cy - ph / 2.0, w: tw, h: ph, radius: radius, color: plate, alpha: 0}
      shape("plate_p${pi}_c${j}", "roundRect", kfPlate)
      let kfTxt = table{}
      kfTxt[toStr(t0)]          = table{content: c.w, x: cx, y: cy, size: size * sc, color: ink, alpha: 0, scale: 0.86, rotate: -3}
      kfTxt[toStr(t0 + 0.09)]   = table{content: c.w, x: cx, y: cy, size: size * sc, color: ink, alpha: 1, scale: 1, rotate: 0, ease: "cubicOut"}
      kfTxt[toStr(tOff - 0.04)] = table{content: c.w, x: cx, y: cy, size: size * sc, color: ink, alpha: 1}
      kfTxt[toStr(tOff)]        = table{content: c.w, x: cx, y: cy, size: size * sc, color: ink, alpha: 0}
      text("word_p${pi}_c${j}", kfTxt)
      x = x + tw + gap * sc
    }
  }
}

// A slow camera push across the beat: the calm default.
let pushIn = fn(from, to, cx, cy) {
  return table{"0": table{x: cx, y: cy, zoom: from}, toStr(DUR): table{x: cx, y: cy, zoom: to, ease: "sine"}}
}
