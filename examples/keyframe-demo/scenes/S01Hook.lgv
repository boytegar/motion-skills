// S01Hook: the hero is already mid-slide on frame 0, tag "1" stamped over it.
// No fade-in, no establishing shot. Push-in accelerates into the cut.

drawRoom(C_BOARD, C_FLOOR)

// The hero, mid-action from frame 0: sliding in from the right, already 70% across.
shape("hero_shade", "rect", table{
  "0": table{x: 520, y: 1114, w: 400, h: 110, color: C_HERO_LO},
  "3.4": table{x: 130, y: 1114, w: 400, h: 110, color: C_HERO_LO}})
shape("hero_body", "roundRect", table{
  "0": table{x: 520, y: 940, w: 400, h: 400, radius: 80, color: C_HERO},
  "3.4": table{x: 130, y: 940, w: 400, h: 400, radius: 80, color: C_HERO, ease: "sine"}})
shape("hero_eye_l", "circle", table{
  "0": table{x: 668, y: 1092, r: 26, color: C_INK},
  "3.4": table{x: 278, y: 1092, r: 26, color: C_INK, ease: "sine"}})
shape("hero_eye_r", "circle", table{
  "0": table{x: 772, y: 1092, r: 26, color: C_INK},
  "3.4": table{x: 382, y: 1092, r: 26, color: C_INK, ease: "sine"}})

// A big torn tag with the number 1, stamped on "number" (frame 34).
drawTag("one", "1", 540, 640, 34 / FPSR, 190, C_TAG, C_TAG_TEXT, 24)

// A faint trail of ghost plates behind the hero: the frames it already crossed.
shape("trail_1", "rect", table{
  "0": table{x: 960, y: 980, w: 90, h: 320, radius: 45, color: C_CREAM_LO, alpha: 0.25}})
shape("trail_2", "rect", table{
  "0": table{x: 1075, y: 1000, w: 60, h: 280, radius: 45, color: C_CREAM_LO, alpha: 0.15}})

drawBanner(BANNER)
drawCaptions(CAPS)

// The last ~10 frames accelerate: pull back then push into the cut (hook skill rule).
camera(table{
  "0": table{x: 540, y: 960, zoom: 1.04},
  "3.2": table{x: 540, y: 960, zoom: 1.0, ease: "sine"},
  "3.5": table{x: 540, y: 960, zoom: 1.06, ease: "cubicIn"}})
