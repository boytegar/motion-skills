// S02Code: four code rows type in on a screen plate, one per stressed word.
// The point: the whole scene is four lines — so show four lines.

drawRoom(C_BOARD, C_FLOOR)

// The screen plate, slammed in at frame 0 (the cut impact out of the hook).
shape("screen", "rect", table{
  "0": table{x: 110, y: 500, w: 860, h: 640, color: C_SCREEN, alpha: 0},
  "0.12": table{x: 110, y: 560, w: 860, h: 640, color: C_SCREEN, alpha: 1, ease: "cubicOut"}})
shape("screen_hi", "rect", table{
  "0": table{x: 110, y: 560, w: 860, h: 8, color: C_BRASS, alpha: 0.5}})

// Four rows, each typed on after its word lands.
shape("row1", "rect", table{
  "0.5": table{x: 160, y: 630, w: 0, h: 54, color: C_CREAM, alpha: 1},
  "0.85": table{x: 160, y: 630, w: 560, h: 54, color: C_CREAM, alpha: 1, ease: "cubicOut"}})
shape("row2", "rect", table{
  "0.9": table{x: 160, y: 712, w: 0, h: 54, color: C_CREAM_HI, alpha: 1},
  "1.25": table{x: 160, y: 712, w: 700, h: 54, color: C_CREAM_HI, alpha: 1, ease: "cubicOut"}})
shape("row3", "rect", table{
  "2.0": table{x: 160, y: 794, w: 0, h: 54, color: C_CREAM, alpha: 1},
  "2.3": table{x: 160, y: 794, w: 420, h: 54, color: C_CREAM, alpha: 1, ease: "cubicOut"}})
shape("row4", "rect", table{
  "2.35": table{x: 160, y: 876, w: 0, h: 54, color: C_TAG, alpha: 1},
  "2.65": table{x: 160, y: 876, w: 640, h: 54, color: C_TAG, alpha: 1, ease: "cubicOut"}})

// The file it came from.
text("file_label", popText("S01Hook.lgv", 540, 1290, 44, 2.35, C_CREAM_HI))

drawBanner(BANNER)
drawCaptions(CAPS)
