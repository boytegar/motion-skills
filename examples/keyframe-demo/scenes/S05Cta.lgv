// S05Cta: the ten-style strip fans out, then the CTA.
// "Ten styles ship this. Clone it, and retime your own."

drawRoom(C_BOARD, C_FLOOR)

// Ten narrow cards fanning out from the centre, one per style, landing on "Ten styles" (f 2-23).
let n = 10
let mid = 4.5
for i in range(0, n) {
  let off = i - mid
  let cx = 540.0 + off * 92.0
  let cy = 860.0 + off * off * 2.0
  let rot = off * 3.0
  let col = C_CREAM
  if i == 3 { col = C_HERO }
  if i == 7 { col = C_SAGE }
  shape("card_${i}", "roundRect", table{
    "0": table{x: cx - 44, y: cy - 150, w: 88, h: 300, radius: 8, color: col, alpha: 0, rotate: rot, scale: 0.6},
    toStr(0.25 + i * 0.11): table{x: cx - 44, y: cy - 150, w: 88, h: 300, radius: 8, color: col, alpha: 1, rotate: rot, scale: 1, ease: "cubicOut"}})
}

text("strip_label", popText("10 / 10 styles", 540, 1150, 50, 1.3, C_CREAM_HI))

// The CTA plate, on "Clone it" (f 44 -> 1.47 s).
drawTag("cta", "git clone motion", 540, 1275, 1.5, 60, C_HERO, C_TAG_TEXT, 12)

// A tiny counter stamp under the plate on "own" (f 83 -> 2.77 s).
text("cta_sub", popText("then edit one number", 540, 1365, 32, 2.8, C_CREAM_HI))

drawBanner(BANNER)
drawCaptions(CAPS)
