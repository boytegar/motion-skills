// ===== papercut tokens and beat furniture =====
//
// Mirrors style/papercut/remotion/kit/tokens.ts. Change a colour there and here together.

let C_INK = "#1C1B17"
let C_INK_SOFT = "#3A3832"
let C_CREAM = "#DACEC0"
let C_CREAM_HI = "#E8DFD3"
let C_CREAM_LO = "#BFB2A2"
let C_TAPE = "#C3B284"
let C_BOARD = "#2E3235"
let C_BOARD_LO = "#202326"
let C_FLOOR = "#4A3020"
let C_FLOOR_LO = "#36221A"
let C_WOOD = "#7F5231"
let C_BRASS = "#C89B4A"
let C_METAL = "#B1B9BC"
let C_SCREEN = "#1B1726"
let C_SCREEN_TEXT = "#E9E2F2"
let C_HERO = "#D67354"
let C_HERO_LO = "#A9553B"
let C_TAG = "#C9573C"
let C_TAG_TEXT = "#F3E6D3"
let C_GO = "#2DA34D"
let C_NOGO = "#D63A2B"
let C_AMBER = "#F3A53B"
let C_SAGE = "#8A9A86"
let C_PURPLE = "#4E3881"

// TTF paths, relative to the episode project (media/ is synced by new_episode.sh).
let F_BANNER = "media/fonts/archivo-black-400-latin.ttf"
let F_CAPTION = "media/fonts/fraunces-900-latin.ttf"
let F_LABEL = "media/fonts/inter-800-latin.ttf"
let F_MONO = "media/fonts/jetbrains-mono-700-latin.ttf"

let CANVAS_W = 1080
let CANVAS_H = 1920
let BANNER_Y = 320
let CAPTION_Y = 1470

// The taped headline: one hard fact per beat, 3-7 words, caps.
// Its width follows the text, never a fixed box, so a long line never runs off the plate.
let drawBanner = fn(txt) {
  let size = 58
  let w = pad(textW(txt, size), 96)
  if w > 980 { w = 980 }
  shape("banner_tape", "roundRect", table{
    "0": table{x: 540 - w / 2 + 26, y: BANNER_Y - 64, w: w - 52, h: 128, radius: 4, color: C_TAPE, alpha: 0},
    "0.1": table{x: 540 - w / 2 + 26, y: BANNER_Y - 64, w: w - 52, h: 128, radius: 4, color: C_TAPE, alpha: 0.9}})
  shape("banner_plate", "rect", table{
    "0": table{x: 540 - w / 2, y: BANNER_Y - 50, w: w, h: 100, color: C_CREAM, alpha: 0},
    "0.1": table{x: 540 - w / 2, y: BANNER_Y - 50, w: w, h: 100, color: C_CREAM, alpha: 1, ease: "cubicOut"}})
  text("banner_text", table{
    "0": table{content: txt, x: 540, y: BANNER_Y, size: size, font: F_BANNER, color: C_INK, alpha: 0},
    "0.1": table{content: txt, x: 540, y: BANNER_Y, size: size, font: F_BANNER, color: C_INK, alpha: 1}})
}

// The spoken words as torn tags in the caption band.
let drawCaptions = fn(list) {
  drawCaptionRow(list, CAPTION_Y, 52, C_TAG, C_TAG_TEXT, 960, 6)
}

// A room: board wall, floor, and a soft shade strip where they meet.
let drawRoom = fn(wall, floor) {
  shape("wall", "rect", table{"0": table{x: 0, y: 0, w: CANVAS_W, h: 1560, color: wall}})
  shape("floor", "rect", table{"0": table{x: 0, y: 1560, w: CANVAS_W, h: 360, color: floor}})
  shape("skirting", "rect", table{"0": table{x: 0, y: 1540, w: CANVAS_W, h: 24, color: C_INK}})
}

// The boxy hero: body, two eyes, a shade strip. Pin it with x/y; it bobs on its own.
let drawHero = fn(cx, cy, r, body) {
  let shade = C_HERO_LO
  if body != C_HERO { shade = C_INK }
  shape("hero_shade", "rect", table{"0": table{x: cx - r, y: cy + r * 0.45, w: r * 2, h: r * 0.55, color: shade}})
  shape("hero_body", "roundRect", table{"0": table{x: cx - r, y: cy - r, w: r * 2, h: r * 2, radius: r * 0.2, color: body}})
  shape("hero_eye_l", "circle", table{"0": table{x: cx - r * 0.38, y: cy - r * 0.12, r: r * 0.13, color: C_INK}})
  shape("hero_eye_r", "circle", table{"0": table{x: cx + r * 0.38, y: cy - r * 0.12, r: r * 0.13, color: C_INK}})
}
