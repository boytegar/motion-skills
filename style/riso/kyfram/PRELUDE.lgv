// ===== riso tokens and beat furniture (kyfram) =====
//
// Minimal prelude. Two-ink riso print on warm white: pink, blue and yellow, deliberate misregistration.
// The palette matches style/riso/fframes/src/tokens.rs and style.json. Extend
// this as the style grows; keep raw hex out of scene files. No style TTFs ship
// here, so the built-in bold sans is used; add `font:` to a text() table if this
// style needs a face.

let C_BG = "#FFFDF5"
let C_SURFACE = "#FFFDF5"
let C_FG = "#222222"
let C_INK = "#222222"
let C_ACCENT = "#FF48B0"
let C_PINK = "#FF48B0"
let C_BLUE = "#0078BF"
let C_YELLOW = "#FFE800"

let CANVAS_W = 1080
let CANVAS_H = 1920
let BANNER_Y = 336
let CAPTION_Y = 1420

// Full-canvas ground. Call it first, once per scene.
let drawBackdrop = fn() {
  shape("bg", "rect", table{"0": table{x: 0, y: 0, w: CANVAS_W, h: CANVAS_H, color: C_BG}})
}

// The beat's headline, sized to its text so a long line never runs off the plate.
let drawBanner = fn(txt) {
  if len(txt) == 0 { return 0 }
  let size = 56
  let w = pad(textW(txt, size), 92)
  if w > 980 { w = 980 }
  shape("banner_plate", "roundRect", table{
    "0": table{x: 540 - w / 2, y: BANNER_Y - 50, w: w, h: 100, radius: 2, color: C_YELLOW, alpha: 0},
    "0.1": table{x: 540 - w / 2, y: BANNER_Y - 50, w: w, h: 100, radius: 2, color: C_YELLOW, alpha: 1, ease: "cubicOut"}})
  text("banner_text", table{
    "0": table{content: txt, x: 540, y: BANNER_Y, size: size, color: C_INK, alpha: 0},
    "0.1": table{content: txt, x: 540, y: BANNER_Y, size: size, color: C_INK, alpha: 1}})
}

// The spoken words as tags in the caption band.
let drawCaptions = fn(list) {
  drawCaptionRow(list, CAPTION_Y, 52, C_PINK, C_BG, 960, 6)
}

// A generic panel: use it for screens, cards, labels. Pin it with cx/cy.
let drawPanel = fn(nm, cx, cy, w, h, fill) {
  shape("panel_${nm}", "roundRect", table{
    "0": table{x: cx - w / 2, y: cy - h / 2, w: w, h: h, radius: 8, color: fill, alpha: 0},
    "0.1": table{x: cx - w / 2, y: cy - h / 2, w: w, h: h, radius: 8, color: fill, alpha: 1, ease: "cubicOut"}})
}

// One accent dot or bullet, for pointing at the thing you are naming.
let drawDot = fn(nm, cx, cy, r, fill) {
  shape("dot_${nm}", "circle", table{
    "0": table{x: cx, y: cy, r: r, color: fill, alpha: 0},
    "0.09": table{x: cx, y: cy, r: r, color: fill, alpha: 1}})
}

// A panel edge when the panel fill equals the ground: an unfilled polygon outline
// (rect has no stroke, so the four corners are spelled out; kyfram's rotate pivot
// for rect is undocumented, polygon is the precise one anyway).
let drawFrame = fn(nm, cx, cy, w, h, edge) {
  let x0 = cx - w / 2
  let y0 = cy - h / 2
  let x1 = cx + w / 2
  let y1 = cy + h / 2
  shape("frame_${nm}", "polygon", table{
    "0": table{points: [x0, y0, x1, y0, x1, y1, x0, y1], filled: false, width: 3, color: edge, alpha: 0},
    "0.1": table{points: [x0, y0, x1, y0, x1, y1, x0, y1], filled: false, width: 3, color: edge, alpha: 1, ease: "cubicOut"}})
}
